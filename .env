# PayTrack — Configuração via Variáveis de Ambiente
# Este arquivo é carregado automaticamente pelo dotenv na inicialização da aplicação.
# Em outros ambientes, defina as mesmas variáveis no sistema operacional ou na pipeline.

# ============================================
# CONFIGURAÇÃO DA API EXTERNA
# ============================================

# URL base da RandomUser API
RANDOMUSER_API_URL=https://randomuser.me/api

# Timeout da requisição (em ms)
RANDOMUSER_TIMEOUT=15000

# ============================================
# CONFIGURAÇÃO DO BANCO DE DADOS
# ============================================

# Caminho do arquivo SQLite (relativo a raiz do projeto)
DATABASE_PATH=./data/paytrack.db

# ============================================
# CONFIGURAÇÃO DE RELATÓRIOS
# ============================================

# Diretório onde salvar os relatórios (relativo a raiz)
REPORTS_OUTPUT_DIR=./reports

# ============================================
# AMBIENTE
# ============================================

# development | production | test
NODE_ENV=development

# ============================================
# LOGGING
# ============================================

# debug | info | warn | error
LOG_LEVEL=info
