{
    "project": {
        "name": "PayTrack",
        "version": "1.0.0",
        "description": "Sistema de sincronização de dados de usuários/RH de API externa para SQLite com relatórios",
        "purpose": "Desafio técnico — vaga Analista de Integrações",
        "status": "ready-for-production",
        "lastUpdated": "2026-03-10"
    },
    "engineering": {
        "patterns": [
            "Domain-Driven Design (DDD)",
            "Clean Architecture (Camadas)",
            "SOLID Principles",
            "Composition Root",
            "Dependency Injection",
            "Repository Pattern"
        ],
        "security": {
            "owasp": [
                {
                    "vulnerability": "SQL Injection (A03:2021)",
                    "status": "mitigated",
                    "implementation": "Prepared Statements (sql.js)"
                },
                {
                    "vulnerability": "Injection (A01:2021)",
                    "status": "mitigated",
                    "implementation": "Input Validation (User.isValid())"
                },
                {
                    "vulnerability": "Identification and Authentication (A07:2021)",
                    "status": "planned",
                    "implementation": ".env + dotenv (1 sprint)",
                    "priority": "high"
                },
                {
                    "vulnerability": "SSRF (A10:2021)",
                    "status": "monitored",
                    "implementation": "URL validation (backlog)",
                    "priority": "medium"
                }
            ]
        }
    },
    "stack": {
        "runtime": "Node.js 18+",
        "packageManager": "npm 8+",
        "language": "JavaScript (CommonJS)",
        "dependencies": {
            "production": [
                {
                    "name": "axios",
                    "version": "^1.7.9",
                    "purpose": "HTTP client",
                    "rationale": "Robust, widespread, native retry support"
                },
                {
                    "name": "sql.js",
                    "version": "^1.12.0",
                    "purpose": "SQLite (WASM)",
                    "rationale": "Zero native dependencies, zero-config deployment"
                }
            ],
            "development": [
                {
                    "name": "jest",
                    "version": "^29.7.0",
                    "purpose": "Testing framework",
                    "rationale": "Industry standard, mocks/coverage/watch native"
                },
                {
                    "name": "nodemon",
                    "version": "^3.1.14",
                    "purpose": "Auto-reload in development",
                    "rationale": "Fast feedback loop"
                }
            ]
        }
    },
    "testing": {
        "framework": "Jest",
        "coverage": {
            "statements": 100,
            "branches": 80.39,
            "functions": 100,
            "lines": 100
        },
        "suites": [
            {
                "name": "User (Domain Entity)",
                "file": "tests/unit/domain/User.test.js",
                "type": "unit",
                "tests": 11,
                "coverage": "100%"
            },
            {
                "name": "SyncUsersUseCase (Application)",
                "file": "tests/unit/application/SyncUsersUseCase.test.js",
                "type": "unit (with mocks)",
                "tests": 9,
                "coverage": "100%"
            },
            {
                "name": "RandomUsersClient (Infrastructure)",
                "file": "tests/unit/infrastructure/RandomUsersClient.test.js",
                "type": "unit (axios mocked)",
                "tests": 7,
                "coverage": "100%"
            },
            {
                "name": "UserRepository (Integration)",
                "file": "tests/integration/UserRepository.test.js",
                "type": "integration (sql.js in-memory)",
                "tests": 11,
                "coverage": "100%"
            }
        ],
        "totalTests": 44,
        "command": "npm test",
        "commandWithCoverage": "npm test -- --coverage",
        "executionTime": "~4.4 seconds"
    },
    "architecture": {
        "layers": [
            {
                "name": "Domain",
                "path": "src/domain/",
                "responsibility": "Business logic — pure, no external dependencies",
                "modules": [
                    {
                        "name": "User",
                        "file": "Users.js",
                        "methods": [
                            "constructor",
                            "isAdult()",
                            "isValid()"
                        ],
                        "testable": true,
                        "reusable": true
                    }
                ]
            },
            {
                "name": "Application",
                "path": "src/application/",
                "responsibility": "Use cases — orchestration logic",
                "modules": [
                    {
                        "name": "SyncUsersUseCase",
                        "file": "SyncUsersUseCase.js",
                        "methods": [
                            "constructor",
                            "execute()"
                        ],
                        "dependencies": [
                            "apiClient",
                            "userRepository"
                        ],
                        "injectable": true
                    }
                ]
            },
            {
                "name": "Infrastructure",
                "path": "src/infrastructure/",
                "responsibility": "Technical details — easy to swap",
                "modules": [
                    {
                        "name": "RandomUsersClient",
                        "folder": "api/",
                        "methods": [
                            "constructor",
                            "fetchUsers()"
                        ]
                    },
                    {
                        "name": "UserRepository",
                        "folder": "database/",
                        "methods": [
                            "insert()",
                            "update()",
                            "findByEmail()",
                            "count()"
                        ]
                    },
                    {
                        "name": "ReportGenerator",
                        "folder": "report/",
                        "methods": [
                            "generate()"
                        ]
                    },
                    {
                        "name": "Connection Manager",
                        "folder": "database/",
                        "methods": [
                            "getConnection()",
                            "saveDatabase()",
                            "closeConnection()"
                        ]
                    }
                ]
            },
            {
                "name": "Root",
                "path": "src/",
                "responsibility": "Dependency injection, composition",
                "modules": [
                    {
                        "name": "main.js",
                        "role": "Composition Root",
                        "orchestrates": [
                            "apiClient",
                            "userRepository",
                            "useCase",
                            "reportGen"
                        ]
                    }
                ]
            }
        ]
    },
    "businessRules": [
        {
            "rule": "Fetch 150 users from API",
            "implementedIn": "config.api.results",
            "enforcer": "RandomUsersClient"
        },
        {
            "rule": "Only adults (age >= 18)",
            "implementedIn": "User.isAdult()",
            "enforcer": "SyncUsersUseCase loop"
        },
        {
            "rule": "Valid email",
            "implementedIn": "User.isValid() regex",
            "enforcer": "SyncUsersUseCase validation"
        },
        {
            "rule": "Unique email (no duplicates)",
            "implementedIn": "UserRepository (UNIQUE constraint)",
            "enforcer": "Database schema"
        },
        {
            "rule": "Insert new, update existing",
            "implementedIn": "findByEmail() → insert() or update()",
            "enforcer": "SyncUsersUseCase logic"
        }
    ],
    "database": {
        "type": "SQLite",
        "driver": "sql.js (WASM)",
        "file": "data/paytrack.db",
        "schema": "Created in UserRepository._initSchema()",
        "table": {
            "name": "users",
            "columns": [
                "id (PRIMARY KEY)",
                "first_name",
                "last_name",
                "full_name",
                "email (UNIQUE)",
                "gender",
                "age",
                "date_of_birth",
                "phone",
                "country",
                "city",
                "state",
                "picture",
                "nationality",
                "created_at",
                "updated_at"
            ],
            "indexes": [
                "idx_users_email (on email)"
            ]
        },
        "upgradeStrategy": {
            "stage1": "sql.js (today, 150 records)",
            "stage2": "better-sqlite3 (when 10k+ records)",
            "stage3": "PostgreSQL (when multi-instance or 100k+ records)"
        }
    },
    "performance": {
        "endToEnd": {
            "value": 1.5,
            "unit": "seconds",
            "breakdown": {
                "dbInit": "~100ms",
                "apiCall": "~1200ms",
                "validation": "~150ms",
                "insertUpdate": "~50ms",
                "reportGen": "~50ms",
                "diskSave": "~10ms"
            }
        },
        "testExecution": {
            "value": 4.4,
            "unit": "seconds",
            "suites": 4,
            "tests": 44
        }
    },
    "deployment": {
